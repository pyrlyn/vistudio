<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runtime-side ETW events for the Visual Studio Performance Profiler. No package dependencies: advapi32 and EventSource come with Windows and .NET Framework. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Vistudio.Etw</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Vistudio.Tests" />
  </ItemGroup>
</Project>
