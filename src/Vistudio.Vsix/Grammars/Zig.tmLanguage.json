{
  "name": "Zig",
  "scopeName": "source.zig",
  "fileTypes": ["zig", "zon"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#builtins" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#calls" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.documentation.container.zig", "match": "//!.*$" },
        { "name": "comment.line.documentation.zig", "match": "///(?!/).*$" },
        { "name": "comment.line.double-slash.zig", "match": "//.*$" }
      ]
    },
    "escapes": {
      "patterns": [
        { "name": "constant.character.escape.zig", "match": "\\\\(?:[nrt'\"\\\\]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]+\\})" },
        { "name": "invalid.illegal.escape.zig", "match": "\\\\." }
      ]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.other.multiline.zig", "match": "\\\\\\\\.*$" },
        { "name": "variable.other.quoted.zig", "begin": "@\"", "end": "\"|$", "patterns": [{ "include": "#escapes" }] },
        { "name": "string.quoted.double.zig", "begin": "\"", "end": "\"|$", "patterns": [{ "include": "#escapes" }, { "name": "constant.other.placeholder.zig", "match": "\\{[^{}\"]*\\}" }] },
        { "name": "string.quoted.single.zig", "match": "'(?:\\\\(?:[nrt'\"\\\\]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]+\\})|[^'\\\\])'" }
      ]
    },
    "builtins": {
      "patterns": [
        { "match": "(@import|@cImport|@embedFile)\\b", "name": "keyword.control.import.zig" },
        { "match": "@[A-Za-z_][A-Za-z0-9_]*", "name": "support.function.builtin.zig" }
      ]
    },
    "declarations": {
      "patterns": [
        { "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": { "1": { "name": "storage.type.function.zig" }, "2": { "name": "entity.name.function.zig" } } },
        { "match": "\\b(const|var)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?::[^=;]*)?=\\s*(?:extern\\s+|packed\\s+)?(struct|enum|union|opaque|error)\\b", "captures": { "1": { "name": "storage.type.zig" }, "2": { "name": "entity.name.type.zig" }, "3": { "name": "storage.type.struct.zig" } } },
        { "match": "\\b(test)\\s+(\"[^\"]*\"|[A-Za-z_][A-Za-z0-9_]*)", "captures": { "1": { "name": "keyword.other.test.zig" }, "2": { "name": "entity.name.function.test.zig" } } }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.zig", "match": "\\b(break|continue|defer|errdefer|else|for|if|orelse|return|switch|try|catch|while|unreachable|suspend|resume|nosuspend|async|await)\\b" },
        { "name": "storage.type.zig", "match": "\\b(fn|const|var|comptime|test|asm|usingnamespace)\\b" },
        { "name": "storage.type.struct.zig", "match": "\\b(struct|enum|union|error|opaque)\\b" },
        { "name": "storage.modifier.zig", "match": "\\b(pub|extern|export|packed|inline|noinline|threadlocal|align|allowzero|callconv|linksection|noalias|volatile|addrspace)\\b" },
        { "name": "keyword.operator.word.zig", "match": "\\b(and|or)\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "storage.type.builtin.zig", "match": "\\b(?:[iu](?:0|[1-9][0-9]*)|isize|usize|f16|f32|f64|f80|f128|bool|void|noreturn|type|anyerror|anyopaque|anyframe|anytype|comptime_int|comptime_float|c_char|c_short|c_ushort|c_int|c_uint|c_long|c_ulong|c_longlong|c_ulonglong|c_longdouble)\\b" },
        { "name": "entity.name.type.zig", "match": "\\b[A-Z][A-Za-z0-9_]*\\b(?!\\s*\\()" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.zig", "match": "\\b(true|false|null|undefined)\\b" },
        { "name": "constant.other.enum-literal.zig", "match": "(?<![A-Za-z0-9_)\\]])\\.[A-Za-z_][A-Za-z0-9_]*(?=\\s*[,})=;]|\\s*$)" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.zig", "match": "\\b0x[0-9a-fA-F][0-9a-fA-F_]*(?:\\.[0-9a-fA-F][0-9a-fA-F_]*)?(?:[pP][+-]?[0-9][0-9_]*)?\\b" },
        { "name": "constant.numeric.octal.zig", "match": "\\b0o[0-7][0-7_]*\\b" },
        { "name": "constant.numeric.binary.zig", "match": "\\b0b[01][01_]*\\b" },
        { "name": "constant.numeric.float.zig", "match": "\\b[0-9][0-9_]*(?:\\.[0-9][0-9_]*(?:[eE][+-]?[0-9][0-9_]*)?|[eE][+-]?[0-9][0-9_]*)\\b" },
        { "name": "constant.numeric.decimal.zig", "match": "\\b[0-9][0-9_]*\\b" }
      ]
    },
    "calls": {
      "patterns": [
        { "match": "\\b([a-z_][A-Za-z0-9_]*)(?=\\s*\\()", "captures": { "1": { "name": "entity.name.function.call.zig" } } }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.zig", "match": "(?:\\+%=?|\\+\\|=?|-%=?|-\\|=?|\\*%=?|\\*\\|=?|<<\\|=?|\\.\\*|\\.\\?|\\+\\+|\\*\\*|=>|==|!=|<=|>=|<<=?|>>=?|[-+*/%&|^~!<>=?])" }
      ]
    }
  }
}
