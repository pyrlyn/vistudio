<?xml version="1.0" encoding="utf-8"?>
<!-- mise commands (MisePackage). Compiled to its own menu resource so Commands.vsct and the other packages are untouched. -->
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable">
  <Extern href="stdidcmd.h" /><Extern href="vsshlids.h" />
  <Include href="KnownImageIds.vsct" />
  <Commands package="guidMisePackage">
    <Menus>
      <Menu guid="guidMiseCommands" id="MiseMenu" priority="0x0620" type="Menu">
        <Parent guid="guidMiseCommands" id="MiseToolsGroup" />
        <Strings><ButtonText>Mise</ButtonText><CommandName>Mise</CommandName></Strings>
      </Menu>
    </Menus>
    <Groups>
      <Group guid="guidMiseCommands" id="MiseToolsGroup" priority="0x0620"><Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" /></Group>
      <Group guid="guidMiseCommands" id="MiseActionGroup" priority="0x0100"><Parent guid="guidMiseCommands" id="MiseMenu" /></Group>
      <Group guid="guidMiseCommands" id="MiseConfigGroup" priority="0x0200"><Parent guid="guidMiseCommands" id="MiseMenu" /></Group>
      <Group guid="guidMiseCommands" id="MiseEditorGroup" priority="0x0710"><Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN" /></Group>
    </Groups>
    <Buttons>
      <Button guid="guidMiseCommands" id="Check" priority="0x0100" type="Button">
        <Parent guid="guidMiseCommands" id="MiseActionGroup" />
        <Icon guid="ImageCatalogGuid" id="Refresh" /><CommandFlag>IconIsMoniker</CommandFlag>
        <Strings><ButtonText>Check Tools</ButtonText><ToolTipText>Check that every mise tool is installed and look for updates</ToolTipText><CommandName>Mise.CheckTools</CommandName></Strings>
      </Button>
      <Button guid="guidMiseCommands" id="Install" priority="0x0110" type="Button">
        <Parent guid="guidMiseCommands" id="MiseActionGroup" />
        <Icon guid="ImageCatalogGuid" id="Download" /><CommandFlag>IconIsMoniker</CommandFlag>
        <Strings><ButtonText>Install Missing (mise install)</ButtonText><CommandName>Mise.InstallMissing</CommandName></Strings>
      </Button>
      <Button guid="guidMiseCommands" id="Upgrade" priority="0x0120" type="Button">
        <Parent guid="guidMiseCommands" id="MiseActionGroup" />
        <Icon guid="ImageCatalogGuid" id="Upload" /><CommandFlag>IconIsMoniker</CommandFlag>
        <Strings><ButtonText>Upgrade All (mise upgrade)</ButtonText><ToolTipText>Newest versions inside the requested ones; the config is not changed</ToolTipText><CommandName>Mise.UpgradeAll</CommandName></Strings>
      </Button>
      <Button guid="guidMiseCommands" id="UpgradeToLatest" priority="0x0130" type="Button">
        <Parent guid="guidMiseCommands" id="MiseActionGroup" />
        <Icon guid="ImageCatalogGuid" id="UpdateListItem" /><CommandFlag>IconIsMoniker</CommandFlag>
        <Strings><ButtonText>Upgrade All to Latest (mise upgrade --bump)</ButtonText><ToolTipText>Newest versions overall; rewrites the requested versions in the config</ToolTipText><CommandName>Mise.UpgradeAllToLatest</CommandName></Strings>
      </Button>
      <Button guid="guidMiseCommands" id="Trust" priority="0x0100" type="Button">
        <Parent guid="guidMiseCommands" id="MiseConfigGroup" />
        <Icon guid="ImageCatalogGuid" id="Lock" /><CommandFlag>IconIsMoniker</CommandFlag>
        <Strings><ButtonText>Trust Config (mise trust)</ButtonText><CommandName>Mise.TrustConfig</CommandName></Strings>
      </Button>
      <Button guid="guidMiseCommands" id="OpenConfig" priority="0x0110" type="Button">
        <Parent guid="guidMiseCommands" id="MiseConfigGroup" />
        <Icon guid="ImageCatalogGuid" id="OpenFile" /><CommandFlag>IconIsMoniker</CommandFlag>
        <Strings><ButtonText>Open Config</ButtonText><CommandName>Mise.OpenConfig</CommandName></Strings>
      </Button>
      <Button guid="guidMiseCommands" id="Settings" priority="0x0120" type="Button">
        <Parent guid="guidMiseCommands" id="MiseConfigGroup" />
        <Icon guid="ImageCatalogGuid" id="Settings" /><CommandFlag>IconIsMoniker</CommandFlag>
        <Strings><ButtonText>Settings...</ButtonText><CommandName>Mise.Settings</CommandName></Strings>
      </Button>
      <Button guid="guidMiseCommands" id="EditorCheck" priority="0x0100" type="Button">
        <Parent guid="guidMiseCommands" id="MiseEditorGroup" />
        <Icon guid="ImageCatalogGuid" id="Refresh" /><CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag><CommandFlag>DefaultInvisible</CommandFlag>
        <Strings><ButtonText>mise: Check Tools</ButtonText><CommandName>Mise.EditorCheckTools</CommandName></Strings>
      </Button>
      <Button guid="guidMiseCommands" id="EditorInstall" priority="0x0110" type="Button">
        <Parent guid="guidMiseCommands" id="MiseEditorGroup" />
        <Icon guid="ImageCatalogGuid" id="Download" /><CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag><CommandFlag>DefaultInvisible</CommandFlag>
        <Strings><ButtonText>mise: Install Missing</ButtonText><CommandName>Mise.EditorInstallMissing</CommandName></Strings>
      </Button>
      <Button guid="guidMiseCommands" id="EditorUpgrade" priority="0x0120" type="Button">
        <Parent guid="guidMiseCommands" id="MiseEditorGroup" />
        <Icon guid="ImageCatalogGuid" id="Upload" /><CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag><CommandFlag>DefaultInvisible</CommandFlag>
        <Strings><ButtonText>mise: Upgrade All</ButtonText><CommandName>Mise.EditorUpgradeAll</CommandName></Strings>
      </Button>
      <Button guid="guidMiseCommands" id="EditorUpgradeToLatest" priority="0x0130" type="Button">
        <Parent guid="guidMiseCommands" id="MiseEditorGroup" />
        <Icon guid="ImageCatalogGuid" id="UpdateListItem" /><CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag><CommandFlag>DefaultInvisible</CommandFlag>
        <Strings><ButtonText>mise: Upgrade All to Latest</ButtonText><CommandName>Mise.EditorUpgradeAllToLatest</CommandName></Strings>
      </Button>
    </Buttons>
  </Commands>
  <Symbols>
    <GuidSymbol name="guidMisePackage" value="{c4e2a7d9-6b1f-4a3e-8d5c-2f9b0e7a1c63}" />
    <GuidSymbol name="guidMiseCommands" value="{f1b3c5d7-2e4a-4c6b-9d8e-0a1b2c3d4e6f}">
      <IDSymbol name="MiseToolsGroup" value="0x1000" />
      <IDSymbol name="MiseActionGroup" value="0x1001" />
      <IDSymbol name="MiseConfigGroup" value="0x1002" />
      <IDSymbol name="MiseEditorGroup" value="0x1003" />
      <IDSymbol name="MiseMenu" value="0x2000" />
      <IDSymbol name="Check" value="0x0100" />
      <IDSymbol name="Install" value="0x0101" />
      <IDSymbol name="Upgrade" value="0x0102" />
      <IDSymbol name="UpgradeToLatest" value="0x0103" />
      <IDSymbol name="Trust" value="0x0104" />
      <IDSymbol name="OpenConfig" value="0x0105" />
      <IDSymbol name="Settings" value="0x0106" />
      <IDSymbol name="EditorCheck" value="0x0200" />
      <IDSymbol name="EditorInstall" value="0x0201" />
      <IDSymbol name="EditorUpgrade" value="0x0202" />
      <IDSymbol name="EditorUpgradeToLatest" value="0x0203" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
