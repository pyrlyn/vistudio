<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Project" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>Java Console App (Gradle)</Name>
    <Description>A Java command-line application built with Gradle. Press F5 to debug it in the JVM debugger.</Description>
    <ProjectType>VistudioLanguages</ProjectType>
    <TemplateID>Vistudio.JavaConsoleApp</TemplateID>
    <SortOrder>70</SortOrder>
    <Icon>JavaFile.png</Icon>
    <CreateNewFolder>true</CreateNewFolder>
    <DefaultName>JavaApp</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
    <LocationField>Enabled</LocationField>
    <EnableLocationBrowseButton>true</EnableLocationBrowseButton>
    <LanguageTag>Java</LanguageTag>
    <PlatformTag>Windows</PlatformTag>
    <ProjectTypeTag>Console</ProjectTypeTag>
  </TemplateData>
  <TemplateContent>
    <Project File="project.javaproj" TargetFileName="$projectname$.javaproj" ReplaceParameters="true" />
  </TemplateContent>
</VSTemplate>