<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Project" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>Rust Console App</Name>
    <Description>A Rust command-line program built with Cargo, with a unit test. Press F5 to debug it with the native debugger (MSVC toolchain).</Description>
    <ProjectType>VistudioLanguages</ProjectType>
    <TemplateID>Vistudio.RustConsoleApp</TemplateID>
    <SortOrder>10</SortOrder>
    <Icon>RustFile.png</Icon>
    <CreateNewFolder>true</CreateNewFolder>
    <DefaultName>RustApp</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
    <LocationField>Enabled</LocationField>
    <EnableLocationBrowseButton>true</EnableLocationBrowseButton>
    <LanguageTag>Rust</LanguageTag>
    <PlatformTag>Windows</PlatformTag>
    <ProjectTypeTag>Console</ProjectTypeTag>
  </TemplateData>
  <TemplateContent>
    <Project File="project.rustproj" TargetFileName="$projectname$.rustproj" ReplaceParameters="true" />
  </TemplateContent>
</VSTemplate>