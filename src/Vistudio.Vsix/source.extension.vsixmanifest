<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="Vistudio.Kotlin.6cc1f5c0-99c8-43c6-b605-8dac96970119" Version="0.1.0" Language="en-US" Publisher="Vistudio" />
    <DisplayName>Vistudio Kotlin</DisplayName>
    <Description xml:space="preserve">Kotlin syntax highlighting, language server navigation, Gradle builds and diagnostics, and Kotlin/JVM debugging in Visual Studio.</Description>
    <Tags>Kotlin,Gradle,LSP,Debugging,JVM</Tags>
  </Metadata>
  <Installation ExtensionType="VSSDK+VisualStudio.Extensibility">
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[18.12,19.0)"><ProductArchitecture>amd64</ProductArchitecture></InstallationTarget>
    <!-- Native ARM64 Visual Studio (Windows on ARM); the extension is managed AnyCPU code. -->
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[18.12,19.0)"><ProductArchitecture>arm64</ProductArchitecture></InstallationTarget>
  </Installation>
  <Dependencies><Dependency Id="Microsoft.Framework.NDP" DisplayName=".NET Framework" Version="[4.7.2,)" /></Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[18.0,)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
    <Asset Type="Microsoft.VisualStudio.MefComponent" d:Source="File" Path="Vistudio.Vsix.dll" />
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="File" Path="KotlinGrammar.pkgdef" />
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="File" Path="KotlinFiles.pkgdef" />
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="File" Path="KotlinDebugAdapter.pkgdef" />
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="File" Path="InlayHintColors.pkgdef" />
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="File" Path="ZigFiles.pkgdef" />
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="File" Path="DartFiles.pkgdef" />
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="File" Path="DartDebugAdapter.pkgdef" />
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="File" Path="LanguageFiles.pkgdef" />
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="File" Path="RustWasmFiles.pkgdef" />
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="File" Path="BazelFiles.pkgdef" />
    <Asset Type="Microsoft.VisualStudio.ProjectTemplate" d:Source="File" Path="ProjectTemplates" d:TargetPath="ProjectTemplates" />
  </Assets>
</PackageManifest>
